            contribution: ['author', 'maintainer'] // List of contribution types ('author', 'maintainer' or 'contributor')
        ],
        [
            name: 'Giorgia Gandolfi',
            affiliation: 'University of Trieste, IRCCS San Raffaele Scientific Institute',
            contribution: ['author', 'maintainer'] // List of contribution types ('author', 'maintainer' or 'contributor')
        ],
        [
            name: 'Virginia Gazziero',
            affiliation: 'University of Trieste, Toscana Life Science',
            contribution: ['author', 'maintainer'] // List of contribution types ('author', 'maintainer' or 'contributor')
        ],
        [
            name: 'Brandon Hastings',
            affiliation: 'University of Trieste',
            contribution: ['author'] // List of contribution types ('author', 'maintainer' or 'contributor')
        ],
        [
            name: 'Davide Rambaldi',
            affiliation: 'Human Technopole',
            contribution: ['author'] // List of contribution types ('author', 'maintainer' or 'contributor')
        ],
        [
            name: 'Rodolfo Tolloi',
            affiliation: 'AREA Science Park',
            contribution: ['author'] // List of contribution types ('author', 'maintainer' or 'contributor')
        ],
        [
            name: 'Lucrezia Valeriani',
            affiliation: 'University of Trieste, AREA Science Park',
            contribution: ['author', 'maintainer'] // List of contribution types ('author', 'maintainer' or 'contributor')
