/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// Take as example from test.config
params {
    modules_testdata_base_path = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/tumourevo/data/"
    pipelines_testdata_base_path = "https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/tumourevo/data/"
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners
